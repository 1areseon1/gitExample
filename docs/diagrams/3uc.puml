@startuml
left to right direction

actor "Администратор" as Admin
actor "Арендатор" as Tenant

usecase "Добавить помещение" as UC_AddRoom
usecase "Оформить договор аренды" as UC_Contract
usecase "Проверить доступность помещения" as UC_CheckAvail
usecase "Проверить состояние помещения" as UC_CheckState
usecase "Выдать помещение" as UC_Issue
usecase "Вернуть помещение" as UC_Return
usecase "Закрыть договор" as UC_Close
usecase "Уведомить техслужбу" as UC_Notify
usecase "Просмотреть отчёты" as UC_Reports
usecase "Просмотреть свои договоры" as UC_MyContracts

Admin --> UC_AddRoom
Admin --> UC_Contract
Admin --> UC_CheckState
Admin --> UC_Issue
Admin --> UC_Close
Admin --> UC_Notify
Admin --> UC_Reports

Tenant --> UC_CheckAvail
Tenant --> UC_CheckState
Tenant --> UC_Return
Tenant --> UC_MyContracts

UC_Contract ..> UC_CheckAvail : <<include>>
UC_Issue ..> UC_CheckState : <<include>>
UC_Return ..> UC_CheckState : <<include>>

@enduml